[project]
name = "{{project_name}}"
version = "0.1.0"
description = "Voice intake and clinical scribe, generated by agenticcarekit (voice-care blueprint). Decision support only — not diagnosis, not treatment."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
  "agenticcarekit>={{ack_version}}",
]

[project.scripts]
{{project_name}} = "app.main:cli"

[dependency-groups]
dev = [
  "pytest>=8.2",
]

[tool.ack]
blueprint = "{{blueprint}}"
pack = "{{pack}}"
